{
  "name": "pmo-assistant",
  "version": "0.1.0",
  "description": "Lightweight Claude-powered PMO assistant across Jira, Outlook and Teams",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "node scripts/check-node.cjs",
    "start": "node --env-file-if-exists=.env src/server.js",
    "predev": "node scripts/check-node.cjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "pretest": "node scripts/check-node.cjs",
    "test": "node --test test/*.test.js",
    "pretest:jira": "node scripts/check-node.cjs",
    "test:jira": "node --env-file-if-exists=.env --test test/jira.live.test.js",
    "prems:login": "node scripts/check-node.cjs",
    "ms:login": "node --env-file-if-exists=.env src/microsoft/login.js",
    "pretest:outlook": "node scripts/check-node.cjs",
    "test:outlook": "node --env-file-if-exists=.env --test test/outlook.live.test.js",
    "pretest:teams": "node scripts/check-node.cjs",
    "test:teams": "node --env-file-if-exists=.env --test test/teams.live.test.js",
    "predemo:priorities": "node scripts/check-node.cjs",
    "demo:priorities": "node scripts/priority-demo.js",
    "prechat:setup": "node scripts/check-node.cjs",
    "chat:setup": "node --env-file-if-exists=.env scripts/teams-chat-setup.js",
    "service:install": "scripts/launchagent.sh install",
    "service:status": "scripts/launchagent.sh status",
    "service:restart": "scripts/launchagent.sh restart",
    "service:uninstall": "scripts/launchagent.sh uninstall",
    "prebriefing:test": "node scripts/check-node.cjs",
    "briefing:test": "node --env-file-if-exists=.env scripts/send-test-briefing.js",
    "preteams:post": "node scripts/check-node.cjs",
    "teams:post": "node --env-file-if-exists=.env scripts/post-to-teams.js",
    "prereport": "node scripts/check-node.cjs",
    "report": "node --env-file-if-exists=.env scripts/report.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^5.3.0"
  }
}

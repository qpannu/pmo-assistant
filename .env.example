# Copy to .env and fill in locally. Never commit .env or paste its values into chat.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3100
# Bind to localhost only; the assistant is not exposed to the network.
HOST=127.0.0.1
# debug | info | warn | error
LOG_LEVEL=info
DB_PATH=./data/pmo.db

# ─── Claude (optional, billed per call) ──────────────────────────────────────
ANTHROPIC_API_KEY=
# Briefings, risk analysis, answers and drafts. Off = rule-based text only.
CLAUDE_ENABLED=false
CLAUDE_MODEL=claude-opus-5-5
# Hard cap on Claude calls per day (the assistant falls back to rules beyond it).
CLAUDE_DAILY_CALL_LIMIT=40
# Also ask Claude to re-rank the top three after every sync (more calls; usually not needed).
PRIORITY_USE_CLAUDE=false
# Optional: path to a text file describing your projects, team and conventions.
# It is sent with each call and cached by the API, so it's cheap after the first call.
PMO_CONTEXT_FILE=
# Your name, used in drafts.
MY_NAME=

# ─── Teams notifications to you ──────────────────────────────────────────────
# Webhook URL from a Teams Workflow "Post to a chat when a webhook request is
# received" (see README). Secret — keep it here only. Empty = log only (dry run).
TEAMS_WEBHOOK_URL=
# Briefing times (HH:MM) in BRIEFING_TIMEZONE; empty = that briefing off. Days: 0 = Sunday.
BRIEFING_TIMEZONE=America/New_York
BRIEFING_MORNING=07:00
BRIEFING_MIDDAY=12:30
BRIEFING_EOD=17:30
BRIEFING_DAYS=1,2,3,4,5
# If the Mac was asleep/off at the scheduled time, still send within this many minutes.
BRIEFING_GRACE_MINUTES=240

# Named Jira scopes for the briefing and chat (JSON). Default covers ezCater.
# PMO_SCOPES={"ezCater":"parentEpic in (214734, 214736, 214738, 214740, 228301, 229224, 236241, 245356, 256765) AND issuetype != Epic AND statusCategory != Done","Team Tesla":"<JQL>"}
PMO_SCOPES=
# Used for "draft a response to my manager".
MY_MANAGER_NAME=
MY_MANAGER_EMAIL=

# Outlook calendar for the briefing's Calendar section (Calendars.Read).
MS_CALENDAR_ENABLED=true
# No IT needed: publish your Outlook calendar (Outlook on the web → Settings → Calendar →
# Shared calendars → Publish a calendar → Can view all details) and paste the ICS link here.
# Used whenever Microsoft isn't signed in. Treat it like a password: anyone with it can read your calendar.
OUTLOOK_ICS_URL=
# Your email, so meetings you organize are recognized (defaults to JIRA_EMAIL).
MY_EMAIL=

# ─── Two-way Teams chat ──────────────────────────────────────────────────────
# Chat the assistant listens to (find it with `npm run chat:setup`). Empty = off.
TEAMS_CHAT_ID=
# webhook = reply via TEAMS_WEBHOOK_URL into the Workflows chat (no extra permission)
# graph   = reply in TEAMS_CHAT_ID as you, marked 🤖 (adds ChatMessage.Send)
TEAMS_CHAT_REPLY_MODE=webhook
TEAMS_CHAT_POLL_SECONDS=20

# ─── Jira Cloud (step 2) — read-only ─────────────────────────────────────────
# e.g. https://yourco.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=
# Project keys to watch for production bugs and releases, e.g. OS,REST,UP.
# Issues assigned to, reported by or watched by you are tracked in every project.
JIRA_PROJECTS=
# What counts as a production blocker (names as they appear in Jira).
JIRA_PROD_ISSUE_TYPES=Bug
JIRA_BLOCKER_PRIORITIES=Highest,High
# Optional: only bugs with one of these labels count as production bugs.
JIRA_PROD_LABELS=
# ...and only if updated within this many days (old backlog bugs are not blockers).
JIRA_PROD_ACTIVE_DAYS=30
# An @mention counts as "awaiting my reply" only if it is this recent.
JIRA_REPLY_WINDOW_DAYS=14
# Issues needing a decision from you: by label and/or status name.
JIRA_DECISION_LABELS=needs-decision
JIRA_DECISION_STATUSES=
JIRA_BLOCKED_STATUSES=Blocked,On Hold
# Releases due within this many days are checked for risk.
JIRA_RELEASE_WINDOW_DAYS=14
# Unreleased versions overdue by more than this many days are ignored as abandoned.
JIRA_RELEASE_OVERDUE_DAYS=14
# Full re-sync interval (hours); in between only changed issues are fetched.
JIRA_FULL_SYNC_HOURS=24
JIRA_MAX_ISSUES_PER_SYNC=1000
# Issues you only watch are tracked if updated within this many days (0 = no limit).
JIRA_WATCHER_ACTIVE_DAYS=90

# ─── Jira reports (npm run report -- scrum) ──────────────────────────────────
# Scrum board whose active sprints the scrum report covers (from the board URL: …/boards/<id>).
JIRA_BOARD_ID=
# Only active sprints whose name starts with this, e.g. Restaurant (empty = every active sprint).
REPORT_SPRINT_PREFIX=Restaurant
# In progress / review with no update for this many days → at risk (inferred).
REPORT_STALE_DAYS=3
# Carried over this many sprints or more → "chronic" carry-over (inferred).
REPORT_CARRYOVER_SPRINTS=3

# ─── Microsoft Graph: Outlook + Teams (read-only) ────────────────────────────
# From your Entra app registration (see README). Not secrets; no client secret is used.
MS_TENANT_ID=
MS_CLIENT_ID=
# Sign-in tokens are stored here after `npm run ms:login` (git-ignored, owner-only).
MS_TOKEN_CACHE_PATH=./data/.ms-token.json
MS_OUTLOOK_ENABLED=true
MS_TEAMS_ENABLED=true
# First sync looks back this many days; later syncs fetch only changes.
MS_MAIL_LOOKBACK_DAYS=14
MS_TEAMS_LOOKBACK_DAYS=7
# Requests older than this no longer count as needing your response.
MS_REPLY_WINDOW_DAYS=7
# Your own questions with no answer after this many days become follow-ups.
MS_FOLLOWUP_AFTER_DAYS=3
# Optional channels to watch, e.g. "Restaurant Eng/Releases,Restaurant Eng/General".
# Requires the admin-consented ChannelMessage.Read.All permission.
MS_TEAMS_CHANNELS=
MS_MAX_MESSAGES_PER_SYNC=500

# ─── Sync intervals (minutes) ────────────────────────────────────────────────
SYNC_INTERVAL_JIRA=10
SYNC_INTERVAL_OUTLOOK=5
SYNC_INTERVAL_TEAMS=5

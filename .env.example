# Copy to .env and fill in locally. Never commit .env or paste its values into chat.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3100
# Bind to localhost only; the assistant is not exposed to the network.
HOST=127.0.0.1
# debug | info | warn | error
LOG_LEVEL=info
DB_PATH=./data/pmo.db

# ─── Claude (step 3) ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Jira Cloud (step 2) ─────────────────────────────────────────────────────
# e.g. https://yourco.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ─── Microsoft Graph: Outlook + Teams (steps 4–5) ────────────────────────────
MS_TENANT_ID=
MS_CLIENT_ID=
MS_TOKEN_CACHE_PATH=./data/.msal-cache.json

# ─── Sync intervals (minutes) ────────────────────────────────────────────────
SYNC_INTERVAL_JIRA=10
SYNC_INTERVAL_OUTLOOK=5
SYNC_INTERVAL_TEAMS=5
